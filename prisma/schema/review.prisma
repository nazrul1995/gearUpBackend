model Review {
  id         String   @id @default(cuid())
  customerId String
  gearId     String
  rating     Int
  comment    String?

  customer User @relation( fields: [customerId], references: [id], onDelete: Restrict)
  gear GearItem @relation( fields: [gearId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerId, gearId])
  @@index([gearId, rating])
}
